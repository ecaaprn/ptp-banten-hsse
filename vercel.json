{
  "version": 2,
  "builds": [
    { "src": "*.php", "use": "vercel-php@0.7.3" },
    { "src": "assets/**", "use": "@vercel/static" },
    { "src": "uploads/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/uploads/(.*)", "dest": "/uploads/$1" },
    { "src": "/login", "dest": "/login.php" },
    { "src": "/logout", "dest": "/logout.php" },
    { "src": "/$", "dest": "/index.php" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
